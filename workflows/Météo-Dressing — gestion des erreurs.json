        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into pipeline_errors (workflow, node, message, execution_id, execution_url, payload)\nselect p->>'workflow', p->>'node', p->>'message', p->>'execution_id', p->>'execution_url', p\nfrom (select $1::jsonb as p) t returning id;",
        "options": {
          "queryReplacement": "={{ JSON.stringify($json) }}"
        }
