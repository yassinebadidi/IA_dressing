    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Mise en forme de l'erreur technique (nœud planté, credential invalide, BDD HS...)\nconst ex = $json.execution || {};\nreturn { json: {\n  workflow: ($json.workflow || {}).name || 'inconnu',\n  node: ex.lastNodeExecuted || null,\n  message: (ex.error && ex.error.message) || 'Erreur inconnue',\n  execution_id: ex.id ? String(ex.id) : null,\n  execution_url: ex.url || null,\n  mode: ex.mode || null,\n  stack: ex.error && ex.error.stack ? String(ex.error.stack).slice(0, 2000) : null,\n} };"
      },
      "id": "893bb0df-7ce5-4c8d-8cfe-ad34296e2651",
      "name": "Formater l'erreur",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
